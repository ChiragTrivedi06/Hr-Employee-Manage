.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
.pytype/

# Logs
*.log
logs/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# FastAPI / Uvicorn temporary files
*.pid

# Local databases
*.db
*.sqlite3
*.sqlite

# Alembic
